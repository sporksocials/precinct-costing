#!/bin/sh
# Runs before every `git push`. Stops a broken build reaching Vercel.
#  1. Refuses to push while tracked files have uncommitted changes: the checks below would test files that are
#     NOT in the push (this is how a broken deploy slipped through on 26 Sep 2026).
#  2. Type-checks and runs the tests on exactly what is committed.
# Add PREPUSH_BUILD=1 to also run `next build`. Skip in an emergency with `git push --no-verify`.
cd "$(git rev-parse --show-toplevel)" || exit 1

if ! git diff --quiet HEAD -- . ':(exclude).claude'; then
  echo "pre-push: you have uncommitted changes to tracked files. Commit or stash them first," >&2
  echo "          otherwise the checks would not be testing what you are pushing:" >&2
  git diff --stat HEAD -- . ':(exclude).claude' >&2
  exit 1
fi

echo "pre-push: type check..."
npx tsc --noEmit || { echo "pre-push: type check failed. Push blocked." >&2; exit 1; }

echo "pre-push: tests..."
npx vitest run --reporter=dot >/dev/null 2>&1 || { echo "pre-push: tests failed. Run 'npm test' to see why. Push blocked." >&2; exit 1; }

if [ "$PREPUSH_BUILD" = "1" ]; then
  echo "pre-push: build..."
  npm run build >/dev/null 2>&1 || { echo "pre-push: build failed. Push blocked." >&2; exit 1; }
fi
echo "pre-push: all checks passed."
exit 0
